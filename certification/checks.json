{
  "SchemaVersion": "1.1",
  "Description": "Declarative Domain A (Security) and Domain B (CodeValidation) checks for workqueue-data-processor certification. Operational source of truth for Invoke-Certification.ps1.",
  "LanguageSurfaces": ["Python", "PowerShell", "Secrets"],
  "Policy": {
    "ExecutableAllowlist": ["py", "python", "kpi-analytics.cmd", "gitleaks", "gitleaks.exe"],
    "KnownKinds": [
      "process",
      "ps-parse-bom",
      "pssa",
      "gitleaks",
      "schema-validate",
      "git-clean",
      "python-assert",
      "powershell-assert",
      "policy-scan"
    ]
  },
  "Checks": [
    {
      "Id": "checks-schema",
      "Name": "checks-schema",
      "Domain": "CodeValidation",
      "Surface": "Meta",
      "Category": "schema",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "checks.json structural validation passes (required fields, known Kinds, process allowlist present)",
      "WorkingDirectory": ".",
      "Kind": "schema-validate"
    },
    {
      "Id": "pylint-kpi-modules",
      "Name": "pylint-kpi-modules",
      "Domain": "CodeValidation",
      "Surface": "Python",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Exit 0 and pylint score 10.00/10 under kpi-analytics/.pylintrc",
      "WorkingDirectory": "kpi-analytics",
      "Kind": "process",
      "Executable": "py",
      "Arguments": ["-3.13", "-m", "pylint", "kpi_modules"],
      "SuccessExitCodes": [0],
      "RequirePylintScore": "10.00"
    },
    {
      "Id": "bandit-kpi-modules",
      "Name": "bandit-kpi-modules",
      "Domain": "Security",
      "Surface": "Python",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Exit 0; no Bandit issues on kpi_modules; JSON report under certification/logs/bandit.json",
      "WorkingDirectory": "kpi-analytics",
      "Kind": "process",
      "Executable": "py",
      "Arguments": [
        "-3.13",
        "-m",
        "bandit",
        "-r",
        "kpi_modules",
        "-q",
        "-f",
        "json",
        "-o",
        "../certification/logs/bandit.json"
      ],
      "SuccessExitCodes": [0],
      "ReportRelativePath": "certification/logs/bandit.json"
    },
    {
      "Id": "ps-parse-bom-excel",
      "Name": "ps-parse-bom-excel",
      "Domain": "CodeValidation",
      "Surface": "PowerShell",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Product excel-toolkit *.ps1/*.psm1 parse under PS 5.1 and are UTF-8 BOM or pure ASCII (sample-test excluded)",
      "WorkingDirectory": ".",
      "Kind": "ps-parse-bom",
      "Path": "excel-toolkit",
      "Include": ["*.ps1", "*.psm1"],
      "ExcludeDirectoryNames": ["sample-test"]
    },
    {
      "Id": "ps-parse-bom-certification",
      "Name": "ps-parse-bom-certification",
      "Domain": "CodeValidation",
      "Surface": "PowerShell",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "certification harness *.ps1 parse under PS 5.1 and are UTF-8 BOM or pure ASCII",
      "WorkingDirectory": ".",
      "Kind": "ps-parse-bom",
      "Path": "certification",
      "Include": ["*.ps1"],
      "ExcludeDirectoryNames": ["logs"]
    },
    {
      "Id": "pssa-excel-error",
      "Name": "pssa-excel-error",
      "Domain": "Security",
      "Surface": "PowerShell",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Invoke-ScriptAnalyzer -Severity Error on product excel-toolkit *.ps1/*.psm1 yields zero findings (sample-test excluded)",
      "WorkingDirectory": ".",
      "Kind": "pssa",
      "Path": "excel-toolkit",
      "Include": ["*.ps1", "*.psm1"],
      "ExcludeDirectoryNames": ["sample-test"],
      "AnalyzerSeverity": "Error"
    },
    {
      "Id": "pssa-certification-error",
      "Name": "pssa-certification-error",
      "Domain": "Security",
      "Surface": "PowerShell",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Invoke-ScriptAnalyzer -Severity Error on certification *.ps1 yields zero findings",
      "WorkingDirectory": ".",
      "Kind": "pssa",
      "Path": "certification",
      "Include": ["*.ps1"],
      "ExcludeDirectoryNames": ["logs"],
      "AnalyzerSeverity": "Error"
    },
    {
      "Id": "gitleaks-repo",
      "Name": "gitleaks-repo",
      "Domain": "Security",
      "Surface": "Secrets",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "gitleaks detect exit 0 for both working-tree (--no-git) and git-history modes (no leaks)",
      "WorkingDirectory": ".",
      "Kind": "gitleaks",
      "Modes": ["workdir", "git"],
      "ReportFileNamePrefix": "gitleaks"
    },
    {
      "Id": "validate-score",
      "Name": "validate-score",
      "Domain": "CodeValidation",
      "Surface": "Python",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "kpi-analytics.cmd validate-score exit 0 (handcalc fixtures green)",
      "WorkingDirectory": "kpi-analytics",
      "Kind": "process",
      "Executable": "kpi-analytics.cmd",
      "Arguments": ["validate-score"],
      "SuccessExitCodes": [0]
    },
    {
      "Id": "validate-score-rcm",
      "Name": "validate-score-rcm",
      "Domain": "CodeValidation",
      "Surface": "Python",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "kpi-analytics.cmd validate-score with RCM dual-attribution golden fixtures exit 0",
      "WorkingDirectory": "kpi-analytics",
      "Kind": "process",
      "Executable": "kpi-analytics.cmd",
      "Arguments": [
        "validate-score",
        "--csv",
        "fixtures/rcm_impact_example.csv",
        "--config",
        "fixtures/rcm_impact_config.json",
        "--expected",
        "fixtures/rcm_impact_expected.json"
      ],
      "SuccessExitCodes": [0]
    },
    {
      "Id": "validate-score-slim",
      "Name": "validate-score-slim",
      "Domain": "CodeValidation",
      "Surface": "Python",
      "Category": "static",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "kpi-analytics.cmd validate-score --output-mode slim with slim_poi golden exit 0",
      "WorkingDirectory": "kpi-analytics",
      "Kind": "process",
      "Executable": "kpi-analytics.cmd",
      "Arguments": [
        "validate-score",
        "--csv",
        "fixtures/v1_handcalc_input.csv",
        "--config",
        "fixtures/v1_handcalc_config.json",
        "--expected",
        "fixtures/slim_poi_expected.json",
        "--output-mode",
        "slim"
      ],
      "SuccessExitCodes": [0]
    },
    {
      "Id": "invariant-privacy-score",
      "Name": "invariant-privacy-score",
      "Domain": "Security",
      "Surface": "Python",
      "Category": "dynamic",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Score with privacy on: DOB blank; patient mask pattern; no raw fixture PHI strings in output",
      "WorkingDirectory": ".",
      "Kind": "python-assert",
      "Script": "certification/scripts/invariant_privacy_score.py"
    },
    {
      "Id": "invariant-profile-denylist",
      "Name": "invariant-profile-denylist",
      "Domain": "Security",
      "Surface": "Python",
      "Category": "dynamic",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Profile envelope rejects rows/claims/data/records; valid profile accepts",
      "WorkingDirectory": ".",
      "Kind": "python-assert",
      "Script": "certification/scripts/invariant_profile_denylist.py"
    },
    {
      "Id": "invariant-diagnostics-keys",
      "Name": "invariant-diagnostics-keys",
      "Domain": "Security",
      "Surface": "Python",
      "Category": "dynamic",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "diagnostics result key tree has no PHI/claim dump shapes",
      "WorkingDirectory": ".",
      "Kind": "python-assert",
      "Script": "certification/scripts/invariant_diagnostics_keys.py"
    },
    {
      "Id": "invariant-automation-security",
      "Name": "invariant-automation-security",
      "Domain": "Security",
      "Surface": "PowerShell",
      "Category": "dynamic",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "ExcelCom.psm1 sets AutomationSecurity = 3 on non-comment line",
      "WorkingDirectory": ".",
      "Kind": "python-assert",
      "Script": "certification/scripts/invariant_automation_security.py"
    },
    {
      "Id": "invariant-password-json-contract",
      "Name": "invariant-password-json-contract",
      "Domain": "Security",
      "Surface": "PowerShell",
      "Category": "dynamic",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Excel CLI/module JSON payloads expose PasswordUsed boolean only; no password property serialization",
      "WorkingDirectory": ".",
      "Kind": "python-assert",
      "Script": "certification/scripts/invariant_password_json_contract.py"
    },
    {
      "Id": "policy-banned-patterns",
      "Name": "policy-banned-patterns",
      "Domain": "Security",
      "Surface": "Meta",
      "Category": "policy",
      "Required": true,
      "Severity": "critical",
      "PassCriteria": "Zero critical banned-pattern matches in product trees (see policies/banned-patterns.json)",
      "WorkingDirectory": ".",
      "Kind": "policy-scan",
      "PatternsFile": "certification/policies/banned-patterns.json"
    },
    {
      "Id": "ship-clean-git",
      "Name": "ship-clean-git",
      "Domain": "CodeValidation",
      "Surface": "Meta",
      "Category": "engine",
      "Required": true,
      "Severity": "critical",
      "ShipOnly": true,
      "PassCriteria": "Git working tree clean (no porcelain) when -Mode Ship",
      "WorkingDirectory": ".",
      "Kind": "git-clean"
    }
  ]
}
