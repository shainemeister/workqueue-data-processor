# Developer tooling only — not a product runtime dependency.
# Copy this file to your package or repo root as `.pylintrc`, or pass:
#   python -m pylint --rcfile=path/to/pylintrc <package_or_paths>
#
# PURPOSE: PEP-8 / consistent-style gate for Python product code.
#   Pass criteria (see RULES.md): exit code 0 and score 10.00/10.
#   Do NOT add pylint as a product runtime dependency for end users.
#
# *** ADOPTER ACTION REQUIRED ***
#   Set py-version below to YOUR project's supported Python version
#   (e.g. 3.11, 3.12, 3.13). The value 3.13 is a starter default only—
#   it is NOT a kit lock-in. Change it before relying on the gate.
#
# Example:
#   python -m pylint mypackage

[MAIN]
jobs = 1
# CHANGE ME: set to the project's supported Python (e.g. 3.11, 3.12, 3.13).
py-version = 3.13
ignore = __pycache__

[MESSAGES CONTROL]
# PEP-8 / style gate only. Design/refactor (too-many-*, consider-using-*) out of scope.
# import-outside-toplevel intentionally omitted (smoke-check / lazy-import patterns).
disable = all

enable =
    line-too-long,
    missing-function-docstring,
    missing-class-docstring,
    missing-module-docstring,
    invalid-name,
    trailing-whitespace,
    missing-final-newline,
    multiple-statements,
    bad-indentation,
    wrong-import-order,
    ungrouped-imports,
    wrong-import-position,
    unused-import,
    unused-variable,
    unused-argument,
    redefined-builtin,
    use-implicit-booleaness-not-comparison-to-zero,
    use-implicit-booleaness-not-comparison-to-string,
    syntax-error,
    undefined-variable,
    used-before-assignment,
    no-member,
    not-callable,
    assignment-from-no-return,
    assignment-from-none,
    unexpected-keyword-arg,
    too-many-function-args,
    no-value-for-parameter

[FORMAT]
max-line-length = 100
indent-string = "    "
expected-line-ending-format =

[BASIC]
# Starter allowlist for short intentional names; extend per project (see RULES adopt steps).
good-names =
    i,
    j,
    k,
    n,
    x,
    _,
    T,
    N,
    id,
    db,
    ex,
    Run,
    fh,
    tf,
    cp,
    sp,
    p,
    ok,
    cfg,
    thr,
    eps,
    exp,
    act,
    mid

[DESIGN]
# Not in the enable list; limits apply only if design checks are re-enabled.
# Design/refactor metrics (too-many-*) stay out of the PEP-8 gate by default.
max-args = 8
max-locals = 40
max-branches = 20
max-statements = 120

[REPORTS]
reports = no
score = yes
