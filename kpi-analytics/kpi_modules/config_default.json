{
  "version": "2.0",
  "description": "Default Priority Matrix weights, thresholds, and field map for kpi-analytics 2.0",
  "as_of_date": null,
  "date_formats": ["%m/%d/%Y", "%Y-%m-%d", "%m-%d-%Y", "%Y/%m/%d"],
  "fields": {
    "service_date": "service_date",
    "out_ins_amt": "out_ins_amt",
    "billed_amount": "billed_amount",
    "days_until_appeal_deadline": "days_until_appeal_deadline",
    "days_on_wq_tab": "days_on_wq_tab",
    "last_worked_date": "last_worked_date",
    "denial_count": "denial_count",
    "days_until_replacement_deadline": "days_until_replacement_deadline"
  },
  "claim_age_target": 45,
  "normalization": "minmax",
  "missing_norm_value": 0.0,
  "weights": {
    "claim_age_days": 0.12,
    "claim_age_disparity": 0.10,
    "out_ins_amt": 0.18,
    "billed_amount": 0.06,
    "appeal_urgency": 0.08,
    "wq_age": 0.06,
    "balance_weighted_days_outstanding": 0.14,
    "denial_count": 0.10,
    "days_since_last_worked": 0.08,
    "dual_deadline_urgency": 0.08
  },
  "metric_direction": {
    "claim_age_days": "higher",
    "claim_age_disparity": "higher",
    "out_ins_amt": "higher",
    "billed_amount": "higher",
    "appeal_urgency": "lower",
    "wq_age": "higher",
    "balance_weighted_days_outstanding": "higher",
    "denial_count": "higher",
    "days_since_last_worked": "higher",
    "dual_deadline_urgency": "lower"
  },
  "chaos": {
    "enabled": true,
    "mean_claim_age_factor": 1.0,
    "share_claim_age_ge_60": 0.40,
    "share_claim_age_ge_90": 0.25,
    "share_claim_age_ge_120": 0.15,
    "multipliers": {
      "claim_age_days": 1.2,
      "claim_age_disparity": 1.4,
      "out_ins_amt": 1.5,
      "billed_amount": 1.0,
      "appeal_urgency": 1.5,
      "wq_age": 1.0,
      "balance_weighted_days_outstanding": 1.2,
      "denial_count": 1.0,
      "days_since_last_worked": 1.0,
      "dual_deadline_urgency": 1.5
    }
  },
  "point_of_interest": {
    "name": "default",
    "multipliers": {
      "claim_age_days": 1.0,
      "claim_age_disparity": 1.0,
      "out_ins_amt": 1.0,
      "billed_amount": 1.0,
      "appeal_urgency": 1.0,
      "wq_age": 1.0,
      "balance_weighted_days_outstanding": 1.0,
      "denial_count": 1.0,
      "days_since_last_worked": 1.0,
      "dual_deadline_urgency": 1.0
    }
  },
  "output": {
    "score_column": "v1_priority_score",
    "mode_column": "v1_queue_mode",
    "prefix": "v1_"
  },
  "kpi_quantifiers": {
    "enabled": true,
    "amount_field": "out_ins_amt",
    "aged_day_breaks": [30, 60, 90, 120],
    "adc": null,
    "adc_lookback_days": 90,
    "adc_mode": "config",
    "credit_policy": "exclude_from_T",
    "emit_static_share": true,
    "emit_exact_delta": true,
    "dual_sign_columns": true
  },
  "privacy": {
    "enabled": true,
    "patient_field": "patient",
    "dob_field": "dob",
    "patient": {
      "mode": "prefix_token",
      "name_order": "last_first",
      "prefix_len": 3,
      "token_digits": 3,
      "token_mode": "alpha_order",
      "uppercase": true,
      "pad_char": "X",
      "empty_policy": "leave_empty"
    },
    "dob": {
      "mode": "omit"
    }
  }
}
