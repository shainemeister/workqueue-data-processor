# Starter ignore list (repo-kit aligned) plus project-specific paths.
# Extend for local tooling as needed.

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDE
.vscode/
.idea/
*.swp
*~

# Secrets / local env
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Python

# Virtual environments
.venv/
venv/
env/

# Coverage / test runners
.coverage
htmlcov/
.tox/

# Node (light — mixed or frontend-adjacent tooling)
node_modules/

# Generated toolkit outputs (regenerable; never commit — see kit/RULES.md)
output/

# Local operator copies under import\ (not cataloged; do not commit PHI)
# Tracked demos remain: wq_synthetic_data.csv / .xlsx / _protected.xlsx only.
import/wq_synthetic_data_[0-9]*.csv
import/wq_synthetic_data_[0-9]*.xlsx
import/*_mapping.json

# User-created scoring profiles (Cluster 1); shipped poi_*.json may be tracked later
kpi-analytics/profiles/user_*.json

# Enterprise diagnostics certificates (regenerable on each machine)
kpi-analytics/diagnostics/last_diagnostics.json
kpi-analytics/diagnostics/last_diagnostics.txt
excel-toolkit/diagnostics/last_diagnostics.json
excel-toolkit/diagnostics/last_diagnostics.txt

# Formal security + code-validation certificates (regenerable; see kit/rules/security.md)
# Distinct from package diagnostics above — do not merge folders.
certification/last_certification.json
certification/last_certification.txt
certification/logs/
